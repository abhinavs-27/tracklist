{
  "name": "music-social-media",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "merge-catalog": "tsx scripts/merge-catalog-duplicates.ts",
    "worker:spotify-enrich": "NODE_OPTIONS='-r ./scripts/register-server-only-stub.cjs' tsx scripts/spotify-enrich-worker.ts",
    "worker:musicbrainz-enrich": "NODE_OPTIONS='-r ./scripts/register-server-only-stub.cjs' tsx scripts/musicbrainz-enrich-worker.ts",
    "dev": "next dev",
    "dev:backend": "npm run dev --prefix backend",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:unit",
    "perf:feed-asymmetry": "node scripts/perf-feed-asymmetry.mjs",
    "perf:album-catalog": "node scripts/perf-album-catalog.mjs",
    "build:sqs-worker": "node scripts/build-sqs-worker.mjs",
    "worker:sqs": "npm run build:sqs-worker && node -r ./scripts/load-env-local.cjs workers/sqs-worker/dist/index.js",
    "build:lambda:billboard-scheduler": "node scripts/build-lambda-billboard-scheduler.mjs",
    "package:lambda:billboard-worker": "node scripts/package-lambda-billboard-worker.mjs",
    "build:lambda:minimal": "node scripts/build-lambda-minimal.mjs",
    "backfill:album-art": "NODE_OPTIONS='-r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-album-art-spotify.ts",
    "backfill:album-art-all": "NODE_OPTIONS='-r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-album-art-all.ts",
    "backfill:taste-snapshots": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-taste-snapshots.ts",
    "backfill:blind-spots": "REDIS_URL='' NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-blind-spots.ts",
    "backfill:musicbrainz-credits": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-musicbrainz-credits.ts",
    "backfill:album-dates": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-album-dates-deezer.ts",
    "backfill:track-order": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-track-order.ts",
    "backfill:artist-discography": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' npx tsx scripts/backfill-artist-discography.ts",
    "backfill:artist-discography:local": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' npx tsx scripts/run-artist-discography-local.ts",
    "backfill:billboard-weeks": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-billboard-weeks.ts",
    "backfill:listening-aggregates": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-listening-aggregates.ts",
    "backfill:lastfm-full-import": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/backfill-lastfm-full-import.ts",
    "lastfm:run-local": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/run-lastfm-imports-local.ts",
    "lastfm:repair": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/repair-lastfm-import.ts",
    "post-import:drain": "NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/post-import-drain.ts",
    "spotify-enrich:local": "REDIS_URL='' SPOTIFY_MIN_TIME_MS=150 SPOTIFY_RESERVOIR_PER_30S=60 SPOTIFY_INTERACTIVE_MIN_TIME_MS=150 SPOTIFY_INTERACTIVE_RESERVOIR_PER_30S=60 SPOTIFY_SEARCH_MIN_TIME_MS=150 SPOTIFY_SEARCH_RESERVOIR_PER_30S=60 NODE_OPTIONS='-r ./scripts/load-env-local.cjs -r ./scripts/register-server-only-stub.cjs' tsx scripts/spotify-enrich-local.ts",
    "build:lambda:taste-snapshot": "node scripts/build-lambda-taste-snapshot.mjs",
    "build:lambda:enrich-drain": "node scripts/build-lambda-enrich-drain.mjs",
    "build:lambda:spotify-enrichment-retry": "node scripts/build-lambda-spotify-enrichment-retry.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/client-sqs": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1050.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@tanstack/react-virtual": "^3.13.24",
    "@tracklist/genius-client": "workspace:*",
    "@tracklist/musicbrainz-client": "workspace:*",
    "@tracklist/spotify-client": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.76.10",
    "fast-average-color-node": "^3.2.0",
    "framer-motion": "^12.39.0",
    "ioredis": "^5.10.1",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-easy-crop": "^5.5.7",
    "server-only": "^0.0.1",
    "tsx": "^4.22.3",
    "undici": "7.24.5"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "brace-expansion": "5.0.6",
    "minimatch": "10.2.4",
    "path-to-regexp": "8.4.0",
    "picomatch": "4.0.4",
    "smol-toml": "1.6.1",
    "srvx": "0.11.13",
    "tar": "7.5.12",
    "undici": "7.24.5",
    "ajv": "8.18.0",
    "uuid": "14.0.0",
    "fast-xml-parser": "^5.7.0",
    "basic-ftp": "5.3.1",
    "follow-redirects": "1.16.0",
    "postcss": "8.5.12",
    "fast-uri": "3.1.2",
    "fast-xml-builder": "1.2.0",
    "eslint": {
      "ajv": "6.14.0"
    },
    "@eslint/eslintrc": {
      "ajv": "6.14.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.7"
  }
}
